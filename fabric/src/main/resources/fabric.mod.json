{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    {
      "name": "${mod_author}",
      "contact": {
        "homepage": "https://zelo.dev/"
      }
    }
  ],
  "contact": {
    "homepage": "https://github.com/Zolo101/RenderScale",
    "sources": "https://github.com/Zolo101/RenderScale",
    "issues": "https://github.com/Zolo101/RenderScale/issues"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/YVuuF9KB5j",
        "modmenu.modrinth" : "https://modrinth.com/mod/renderscale"
      }
    }
  },
  "license": "${license}",
  "icon": "${mod_id}.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.zelo.renderscale.RenderScale"
    ],
    "modmenu": [
      "dev.zelo.renderscale.compat.ModMenuApiImpl"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "accessWidener": "renderscale.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "1.21.6",
    "java": ">=${java_version}",
    "cloth-config": "*"
  }
}
